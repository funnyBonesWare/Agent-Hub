{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://sykrytzmxycqracqltpg.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "agent-gate",
      "version": "0.1.0",
      "title": "Agent Gate"
    },
    "tools": [
      {
        "name": "list_tickets",
        "title": "List support tickets",
        "description": "List support tickets, optionally filtered by status or priority.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by ticket status.",
              "type": "string",
              "enum": [
                "open",
                "pending",
                "resolved"
              ]
            },
            "priority": {
              "description": "Filter by priority.",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "limit": {
              "description": "Max tickets to return (default 20).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_ticket",
        "title": "Get ticket with conversation",
        "description": "Fetch one ticket plus its full conversation thread and any saved drafts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "ticket_id": {
              "type": "string",
              "description": "The ticket UUID."
            }
          },
          "required": [
            "ticket_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_knowledge_base",
        "title": "Search knowledge base",
        "description": "Search support knowledge base articles by keyword and return the best matches.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Keywords to search for."
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_approvals",
        "title": "List approval requests",
        "description": "List AI tool-call approval requests in the human approval queue.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by approval status (default pending).",
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "denied"
              ]
            },
            "limit": {
              "description": "Max rows to return (default 20).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_audit_log",
        "title": "List audit log entries",
        "description": "Read the immutable audit trail of executed and denied AI tool calls (supervisors only).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "ticket_id": {
              "description": "Only entries for this ticket.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows to return (default 25).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
